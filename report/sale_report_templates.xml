<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Override del bloque de dirección de la compañía en el reporte de cotización.
        Si la cotización tiene x_branch_address_id, se imprime esa dirección.
        Si no, se imprime la dirección normal de la compañía (comportamiento estándar).
    -->
    <template id="report_saleorder_branch_address"
              inherit_id="sale.report_saleorder_document">

        <!-- Reemplazamos el bloque de dirección de la compañía -->
        <xpath expr="//div[hasclass('page')]//div[1]" position="before">
            <!-- Bloque invisible que activa la lógica; el override se hace abajo -->
        </xpath>

        <!-- Override del address block de la compañía emisora -->
        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <!-- No tocamos el layout externo directamente -->
        </xpath>

    </template>

    <!--
        Override del layout externo para inyectar la dirección de sucursal.
        Heredamos report_saleorder_document y sobreescribimos la variable
        de compañía que usa el header.
    -->
    <template id="report_saleorder_document_branch"
              inherit_id="sale.report_saleorder_document">

        <!-- Justo antes del t-call del layout, redefinimos la dirección si hay sucursal -->
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <t t-if="doc.x_branch_address_id">
                <!-- Guardamos la dirección original y sobreescribimos temporalmente -->
                <t t-set="o" t-value="doc.x_branch_address_id"/>
            </t>
        </xpath>

    </template>

</odoo>
